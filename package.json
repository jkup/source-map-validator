{
  "name": "source-map-validator-monorepo",
  "private": true,
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "turbo run typecheck",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "update-spec-tests": "node scripts/update-spec-tests.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.8.3",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^2.0.0"
  }
}
